# Copy to .env and run ./start.sh. Model settings may be entered later in the GUI.
# Keep .env private. Blank model credentials do not prevent application startup.
# Paths are relative to .env. Select CSV, OKF and target in the app.
# Quote values containing # or spaces. Restart services after changes.
# MVP web experiments support Azure Foundry only. Keep all providers azure_foundry.
# GUI: Add experiment -> AI model -> Set up a model -> Check & use model.
# A checked GUI connection becomes Use current model for new experiments on this
# installation, across page/container restarts. It applies to all agents; it does
# not overwrite .env or existing experiments. Until one is saved, Use current model
# uses the server's per-agent defaults. Failed checks keep the previous saved default.
# Blank/incomplete server defaults require GUI setup before creating/running an experiment.

# Provider API keys. For normal MVP use, fill only the Azure key (or use the GUI).
# Azure Foundry API key. Example: YOUR_AZURE_FOUNDRY_API_KEY (replace with your real key); blank if unused.
MEMSTARA_AZURE_FOUNDRY_API_KEY=
# The following non-Azure settings are retained for native/runtime compatibility.
# They do not enable other providers in the GUI or for new web executions.
# OpenAI API key. Example: YOUR_OPENAI_API_KEY (replace with your real key); blank if unused.
MEMSTARA_OPENAI_API_KEY=
# Direct Anthropic API key. Example: YOUR_ANTHROPIC_API_KEY; blank for Azure-only use.
MEMSTARA_ANTHROPIC_API_KEY=
# OpenRouter API key. Example: YOUR_OPENROUTER_API_KEY (replace with your real key); blank if unused.
MEMSTARA_OPENROUTER_API_KEY=

# Local OpenAI-compatible server key. Example: YOUR_SERVER_KEY; blank for a keyless server.
MEMSTARA_LOCAL_API_KEY=

# Bedrock region. Example: us-east-1; required only when using bedrock.
AWS_REGION=
# Bedrock API bearer token. Example: YOUR_BEDROCK_API_KEY; leave AWS access credentials blank when using this.
AWS_BEARER_TOKEN_BEDROCK=
# AWS access key ID (alternative to bearer token). Example: YOUR_ACCESS_KEY_ID; requires SECRET_ACCESS_KEY.
AWS_ACCESS_KEY_ID=
# AWS secret access key. Example: YOUR_SECRET_ACCESS_KEY; required together with ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=
# Temporary AWS credential token. Example: YOUR_SESSION_TOKEN; required for temporary access keys, otherwise blank.
AWS_SESSION_TOKEN=

# App and folders

# Browser port. Example: 5173 gives http://127.0.0.1:5173/; choose an unused port.
MEMSTARA_WEB_PORT=5173

# Generated datasets, models, reports and logs. Example: outputs; changing it does not move old files.
MEMSTARA_OUTPUT_DIR=outputs

# Your CSV/OKF input folder. Example: ./user-inputs; mounted read-only at /app/user-inputs in Docker.
MEMSTARA_INPUTS_DIR=./user-inputs

# Downloaded embedding-model cache. Example: outputs/huggingface; mounted at /app/cache in Docker.
HF_HOME=outputs/huggingface

# Local Question Universe embeddings. Example: 0 disables them; 1 enables dependencies/model downloads.
MEMSTARA_UNIVERSE_SEMANTICS=0

# Provider setup reference. MVP web use: keep MEMSTARA_LLM_PROVIDER=azure_foundry.
# azure_foundry: MEMSTARA_AZURE_FOUNDRY_API_KEY + your deployment name + resource URL.
#   MODEL example: my-chat-deployment
#   API_BASE example: https://YOUR_RESOURCE.services.ai.azure.com
#   This route uses Motoro's Azure AI/Foundry integration, not an Azure OpenAI endpoint.
# The providers below are native/runtime reference only, not MVP web options.
# openai: MEMSTARA_OPENAI_API_KEY + an available OpenAI model ID; leave API_BASE blank.
#   MODEL example: gpt-4o (only if available to your account).
# anthropic: MEMSTARA_ANTHROPIC_API_KEY + an available Claude API model ID; leave API_BASE blank.
#   MODEL: copy the exact API model ID from your Anthropic account, not an Azure deployment name.
# openrouter: MEMSTARA_OPENROUTER_API_KEY + the OpenRouter model ID; leave API_BASE blank.
#   MODEL example: openai/gpt-4o (only if available to your account).
# local: served model name + OpenAI-compatible API_BASE + MEMSTARA_LOCAL_API_KEY if required.
#   API_BASE example in Docker on macOS/Windows: http://host.docker.internal:8000/v1
#   Native example: http://127.0.0.1:8000/v1. Docker localhost refers to the container.
#   Linux Docker needs a reachable host address or an explicitly configured host-gateway mapping.
#   HTTP is allowed only for local servers; prefer HTTPS when sending credentials over a network.
# bedrock: AWS_REGION + a Bedrock model/inference-profile ID; normally leave API_BASE blank.
#   MODEL example: amazon.nova-pro-v1:0 (must be available/authorized in your region).
#   Authentication: AWS_BEARER_TOKEN_BEDROCK OR AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
#   Temporary access credentials also require AWS_SESSION_TOKEN. Do not fill both auth methods.
#   Host AWS profiles/SSO files are not automatically mounted; supply credentials in this .env.
# Switching the COMMON provider: also replace MODEL and clear/replace API_BASE yourself.
# Example: switching Azure to OpenAI requires MEMSTARA_LLM_API_BASE= (empty).
# Switching ONE agent's provider: set that agent's PROVIDER and MODEL, plus API_BASE
# where required and the matching provider API key above. Common settings from another
# provider are not inherited. Provider keys are shared across agents of that provider.
# Temperature, token limits and reasoning effort depend on the selected model;
# leave them blank unless you know that model supports the requested values.

# Common model for all agents. Individual non-empty settings below take priority.
# Changing an agent PROVIDER requires its own MODEL and, for Azure/local, API_BASE.
# Common generation settings are inherited only within the same provider.
# ML_MODEL selects the ML agent's LLM, not the trained LR/XGBoost model.

# Common model service. Keep azure_foundry for new MVP web experiments.
MEMSTARA_LLM_PROVIDER=azure_foundry
# Model identifier: Azure deployment name, direct API model ID or OpenRouter model ID; see examples above.
MEMSTARA_LLM_MODEL=
# Azure/local service URL. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank for standard OpenAI/Anthropic/OpenRouter.
MEMSTARA_LLM_API_BASE=
# Common response randomness. Example: 1 (allowed range 0–2); blank uses runtime defaults. Model support varies.
MEMSTARA_LLM_TEMPERATURE=
# Common requested output-token limit. Example: 4096; blank uses runtime defaults. Stay within model limits.
MEMSTARA_LLM_MAX_TOKENS=
# Common reasoning effort. Example: medium; none/minimal/low/medium/high/xhigh/max.
# Leave blank unless supported by your model; availability is model-dependent.
MEMSTARA_LLM_EFFORT=

# Question agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_QUESTION_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_QUESTION_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_QUESTION_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_QUESTION_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_QUESTION_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_QUESTION_EFFORT=

# Hypothesis agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_HYPOTHESIS_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_HYPOTHESIS_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_HYPOTHESIS_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_HYPOTHESIS_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_HYPOTHESIS_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_HYPOTHESIS_EFFORT=

# Data agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_DATA_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_DATA_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_DATA_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_DATA_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_DATA_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_DATA_EFFORT=

# ML agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_ML_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_ML_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_ML_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_ML_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_ML_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_ML_EFFORT=

# Interpretation agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_INTERPRETATION_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_INTERPRETATION_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_INTERPRETATION_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_INTERPRETATION_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_INTERPRETATION_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_INTERPRETATION_EFFORT=

# Explanation agent overrides; leave blank to inherit common settings.
# Service override. Example: azure_foundry; blank inherits MEMSTARA_LLM_PROVIDER.
MEMSTARA_EXPLANATION_PROVIDER=
# Model/deployment override. Example: my-specialist-deployment; blank inherits the common model on the same provider.
MEMSTARA_EXPLANATION_MODEL=
# URL override. Example: https://YOUR_RESOURCE.services.ai.azure.com; blank inherits on the same provider, otherwise uses provider default.
MEMSTARA_EXPLANATION_API_BASE=
# Randomness override. Example: 1 (0–2, model-dependent); blank inherits on the same provider.
MEMSTARA_EXPLANATION_TEMPERATURE=
# Requested output-token limit override. Example: 4096 (within model limits); blank inherits on the same provider.
MEMSTARA_EXPLANATION_MAX_TOKENS=
# Reasoning override. Example: medium (if supported); blank inherits on the same provider.
MEMSTARA_EXPLANATION_EFFORT=

# Optional compute limits

# OpenMP CPU thread limit. Example: 1 reduces CPU use; 2 allows two threads.
OMP_NUM_THREADS=1

# OpenBLAS CPU thread limit. Example: 1 reduces CPU use; 2 allows two threads.
OPENBLAS_NUM_THREADS=1

# Intel MKL CPU thread limit. Example: 1 reduces CPU use; 2 allows two threads.
MKL_NUM_THREADS=1

# Tokenizer parallelism. Example: false reduces concurrency; true enables parallel processing.
TOKENIZERS_PARALLELISM=false

# Optional advanced inputs (normally leave unset)

# Optional ML reference folder. Example: user-inputs/ml-docs containing ml-reference.md and ml-results.md; normally leave commented.
# MEMSTARA_SHARED_SKILLS_DIR=

# Writable folder for app-registered JSON skills. Example: outputs/skills; normally leave commented.
# MEMSTARA_USER_SKILLS_DIR=

# Exclusion-rule JSON for unregistered runs. Example: user-inputs/leakage-rules.json; must exist. Registered inputs use their own rules.
# MEMSTARA_LEAKAGE_RULES_PATH=

# Optional specialist bindings. Example: leave commented to use the selected OKF (recommended).
# Advanced SQLite example for the addiction specialist only (database/table must already exist):
# Example value: '{"addiction":{"expert":"addiction","database_id":"addiction-reference","kind":"sqlite","path":"user-inputs/reference.sqlite","table":"documents","id_column":"id","text_column":"text"}}'
# SQLite example table: documents(id TEXT, text TEXT). Include a binding for every selected specialist.
# Empty {} is not a valid binding; this option is not needed for normal OKF use.
# MEMSTARA_EXPLANATION_SOURCES_JSON='{}'

# Native development only (not used by ./start.sh)

# Native API port only. Example: 8071; Docker startup ignores it and uses private port 8000.
# MEMSTARA_API_PORT=8071

# Native control port only. Example: 8072; Docker startup uses private port 8072.
# MEMSTARA_CONTROL_PORT=8072

# Legacy viewer Compose cache folder. Example: ../outputs/embedding-cache; ./start.sh uses HF_HOME instead.
# MEMSTARA_EMBEDDING_CACHE=../outputs/embedding-cache
