# Memstara sandbox — copy to .env and fill in.
#
#     cp .env.example .env
#     set -a && . ./.env && set +a
#
# ---------------------------------------------------------------------------
# TWO DATABASES. They are not interchangeable, and mixing them up is the
# mistake this file exists to prevent.
# ---------------------------------------------------------------------------

# core's own store: agents, run history, MCP server registrations.
# Owned by motoro; its alembic migrations run against it. Read from the
# core repo's .env — do not point this at Memstara's database.
#
# The role stays `agentic`: motoro's own .env.example:6 sets POSTGRES_USER=agentic,
# so renaming it here would put us out of step with upstream for no gain.
MOTORO_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/motoro

# Memstara's own store: the work board and the results table. Its own container,
# port, volume and account — see docker-compose.yml in this folder.
#
#     docker compose up -d
#
# This is the only database credential handed to our MCP tool servers, via
# `mcp_allowed_env_vars` in settings.py. MOTORO_DATABASE_URL is deliberately
# NOT on that list: core's credentials have no business reaching our servers.
MEMSTARA_DATABASE_URL=postgresql://memstara:memstara@localhost:5463/memstara

# The password the Postgres container is created with. Optional, and left
# commented out on purpose: compose.yml:35 reads `${POSTGRES_PASSWORD:-memstara}`,
# so an unset variable still brings up the historical local container and a
# fresh clone needs no edit here. Uncomment only to set a real one.
#
# It stays commented because an uncommented `POSTGRES_PASSWORD=<value>` in a
# tracked file is a hardcoded credential to every secret scanner that reads the
# repository, whatever the value happens to be. Moving the literal out of
# compose.yml and into this file would have bought nothing.
#
# Two things do NOT happen automatically when you do set it. It does not
# rewrite MEMSTARA_DATABASE_URL above — edit both, or the first claim_task
# fails authentication rather than failing to connect. And it does not
# re-provision an existing container: Postgres applies POSTGRES_PASSWORD only
# while initialising an empty data directory, so an already-created
# `memstara_postgres_data` volume keeps the old password until it is removed.
# POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Paths the tool servers need. All three are on `mcp_allowed_env_vars`; without
# them a server starts and then reports "tools available: []", which reads like
# a connection problem rather than a missing path.
# ---------------------------------------------------------------------------

# The knowledge source bundle the hypothesis stage searches.
#   outputs/okf_synthetic_sample   — the synthetic bundle
AGENTIC_OKF_BUNDLE_DIR=/absolute/path/to/memstara/outputs/okf_synthetic_sample

# The dataset the data stage cuts columns from.
MEMSTARA_DATASET_PATH=/absolute/path/to/memstara/outputs/dataset.csv

# Where sub-datasets are written.
MEMSTARA_OUTPUT_DIR=/absolute/path/to/memstara/outputs

# Which learner train_and_score uses. There is one: xgboost. Leaving this unset is the
# normal case and selects it (`src/memstara/mcp_servers/ml.py:93`); it is a declared
# dependency, so nothing has to be installed by hand.
#
# The variable is kept rather than deleted so that a stale value fails loudly instead of
# being ignored. `sklearn_hgb` and `random_forest` were real until 2026-09-08 and were
# removed; setting either now returns an error saying so, rather than running xgboost
# while you believe otherwise. Any other value is reported as a typo
# (`src/memstara/mcp_servers/ml.py:153-166`).
# MEMSTARA_ML_ENGINE=xgboost

# Optional external documents. Set explicit paths or use ml-results.md and
# ml-reference.md inside MEMSTARA_SHARED_SKILLS_DIR.
# MEMSTARA_SHARED_SKILLS_DIR=
# MEMSTARA_RESULTS_SKILL_PATH=
# MEMSTARA_ML_REFERENCE_PATH=
# Optional JSON mapping of saved skill identifiers to current identifiers.
# MEMSTARA_SKILL_ALIASES_PATH=

# Optional study-approved exact-column exclusions; rebuild the matcher after changes.
# MEMSTARA_LEAKAGE_RULES_PATH=/absolute/path/to/approved-rules.json
