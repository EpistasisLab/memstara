# Copy to project .env. Do not source it or put credentials in .zshrc.
# Local mode uses this file only; literal values, no ${...} expansion.
# CI may explicitly select MEMSTARA_CONFIG_MODE=environment before launch.
# Restart services after edits; active executions keep their frozen settings.

# Required for execution: provider and actual deployment name.
MEMSTARA_LLM_PROVIDER=azure_foundry
MEMSTARA_LLM_MODEL=claude-haiku-5-5
# Foundry: supply the resource NAME or MEMSTARA_LLM_API_BASE resource-root URL.
# If both are provided they must agree. API key is supplied by your resource owner.
ANTHROPIC_FOUNDRY_RESOURCE=YOUR_RESOURCE_NAME
ANTHROPIC_FOUNDRY_API_KEY=YOUR_API_KEY
# MEMSTARA_LLM_API_BASE=https://YOUR_RESOURCE_NAME.services.ai.azure.com
# For anthropic/openai, set the matching provider/model and credential instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional group overrides; blank/unset inherits the default model above.
# Non-explanation: Question, Hypothesis, Data, ML and Interpretation.
# MEMSTARA_NON_EXPLANATION_PROVIDER=
# MEMSTARA_NON_EXPLANATION_MODEL=
# MEMSTARA_NON_EXPLANATION_API_BASE=
# MEMSTARA_EXPLANATION_PROVIDER=
# MEMSTARA_EXPLANATION_MODEL=
# MEMSTARA_EXPLANATION_API_BASE=
# Optional numeric generation settings; temperature 0..2, max_tokens 1..200000.
# MEMSTARA_LLM_TEMPERATURE=1
# MEMSTARA_LLM_MAX_TOKENS=8192
# MEMSTARA_NON_EXPLANATION_TEMPERATURE=1
# MEMSTARA_NON_EXPLANATION_MAX_TOKENS=8192
# MEMSTARA_EXPLANATION_TEMPERATURE=1
# MEMSTARA_EXPLANATION_MAX_TOKENS=8192
# Optional effort: low, medium, high, xhigh or max; provider support varies.
# MEMSTARA_LLM_EFFORT=medium
# MEMSTARA_NON_EXPLANATION_EFFORT=medium
# MEMSTARA_EXPLANATION_EFFORT=medium

# Independent local development databases. Never replace existing installation URLs
# with these demo values during migration. Change ports here for another installation.
MEMSTARA_DATABASE_URL=postgresql://memstara:memstara@127.0.0.1:55641/memstara
MOTORO_DATABASE_URL=postgresql+asyncpg://motoro:motoro@127.0.0.1:55642/motoro
MOTORO_REDIS_URL=redis://127.0.0.1:56391/0
# Compose project must be unique for a NEW installation; lowercase letters/digits/-/_.
MEMSTARA_COMPOSE_PROJECT=memstara-local
# Read-only API accounts must be created/granted separately, as documented in README.
MEMSTARA_VIEWER_DSN=postgresql://memstara_viewer:viewer@127.0.0.1:55641/memstara
CORE_VIEWER_DSN=postgresql://memstara_viewer:viewer@127.0.0.1:55642/motoro
# TCP ports, integers 1..65535, distinct and free on 127.0.0.1.
MEMSTARA_WEB_PORT=5173
MEMSTARA_API_PORT=8071
MEMSTARA_CONTROL_PORT=8072

# Paths resolve relative to this .env, independently of the launch directory.
# Keep local filesystem values relative for portable installations. API/database
# URLs retain their complete scheme and host; they are not filesystem paths.
# These defaults are used when omitted. Research profiles select their own inputs.
MEMSTARA_OUTPUT_DIR=outputs
HF_HOME=outputs/huggingface
# Optional legacy unregistered-run input defaults. Prefer a saved research profile.
# Example after README HeartFailure preparation (do not select its raw source CSV):
# MEMSTARA_DATASET_PATH=outputs/heart-failure-demo/dataset.csv
# AGENTIC_OKF_BUNDLE_DIR=examples/heart-failure/okf
# MEMSTARA_OUTCOME_COLUMN=chronic_heart_failure
# MEMSTARA_DATASET_PATH=
# AGENTIC_OKF_BUNDLE_DIR=
# MEMSTARA_OUTCOME_COLUMN=outcome

# Conservative local compute limits (threads); tokenizer flag is true/false.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Optional custom instructions/rules. Bundled skills require no external paths.
# MEMSTARA_SPECIALIST_SKILLS_DIR=
# MEMSTARA_SHARED_SKILLS_DIR=
# MEMSTARA_RESULTS_SKILL_PATH=
# MEMSTARA_ML_REFERENCE_PATH=
# MEMSTARA_USER_SKILLS_DIR=
# MEMSTARA_SKILL_ALIASES_PATH=
# MEMSTARA_LEAKAGE_RULES_PATH=
# MEMSTARA_EXPLANATION_SOURCES=
# MEMSTARA_ML_ENGINE=xgboost

# Legacy stage-model JSON is migration input only; do not set MEMSTARA_STAGE_MODELS_PATH.
# No sibling Motoro .env is loaded. PATH and ordinary OS settings remain inherited.

# Optional Question Universe local embeddings (viewer only, no remote inference).
# Rebuild the viewer API with this flag; cache the pinned model first.
MEMSTARA_UNIVERSE_SEMANTICS=0
# Relative to viewer/docker-compose.yml; the container reads this directory only.
MEMSTARA_EMBEDDING_CACHE=../outputs/embedding-cache
