# Memstara settings. Copy .env.example to .env and enter your model credentials.
# Never commit .env. Quote values containing # or spaces; do not use ${...} expansion.
# After edits, run ./start.sh during maintenance; it restarts services and retains saved data.
# Database accounts, connections and Docker identity are automatic; do not configure DSNs.
# Keep generated .memstara/ and compose.override.yaml with this installation.
# Relative folder paths start beside .env. Defaults normally need no changes.
# Select CSV, OKF, target and ML skills in the app, not here.
# Optional cost estimates: Settings and more > Cost estimate settings (not actual Azure billing).

# Provider credentials only. Models and endpoints are configured per agent below.
# Shared by agents using Azure Foundry; never determines which model is selected.
MEMSTARA_AZURE_FOUNDRY_API_KEY=YOUR_API_KEY
# Other providers: fill only the credential required by your agent assignments.
MEMSTARA_OPENAI_API_KEY=
MEMSTARA_ANTHROPIC_API_KEY=
MEMSTARA_OPENROUTER_API_KEY=

# App and folders

# Browser port on this computer. Choose an unused port, then open http://127.0.0.1:<port>/.
MEMSTARA_WEB_PORT=5173

# Generated datasets, models, reports and execution logs. "outputs" is beside .env.
# Not the original CSV; select CSV/OKF/target in the app. Changing this path does not move old files.
MEMSTARA_OUTPUT_DIR=outputs

# Folder for your CSV/OKF inputs; Docker exposes it read-only as /app/user-inputs.
MEMSTARA_INPUTS_DIR=./user-inputs

# Downloaded embedding-model cache folder; Docker mounts it at /app/cache.
HF_HOME=outputs/huggingface

# Question Universe local embeddings: 0 = disabled, 1 = enabled (extra dependencies/model download).
MEMSTARA_UNIVERSE_SEMANTICS=0

# Independent agent assignments: PROVIDER and MODEL are required for every agent.
# Azure Foundry also requires API_BASE. No common model or endpoint is inherited.
# Empty generation options use the model runtime defaults, not another agent.
# ML_MODEL is the ML agent's LLM, not the trained LR/XGBoost model.

# Question agent
# Model service; set explicitly for this agent.
MEMSTARA_QUESTION_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_QUESTION_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_QUESTION_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_QUESTION_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_QUESTION_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_QUESTION_EFFORT=

# Hypothesis agent
# Model service; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_HYPOTHESIS_EFFORT=

# Data agent
# Model service; set explicitly for this agent.
MEMSTARA_DATA_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_DATA_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_DATA_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_DATA_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_DATA_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_DATA_EFFORT=

# Ml agent
# Model service; set explicitly for this agent.
MEMSTARA_ML_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_ML_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_ML_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_ML_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_ML_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_ML_EFFORT=

# Interpretation agent
# Model service; set explicitly for this agent.
MEMSTARA_INTERPRETATION_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_INTERPRETATION_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_INTERPRETATION_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_INTERPRETATION_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_INTERPRETATION_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_INTERPRETATION_EFFORT=

# Explanation agent
# Model service; set explicitly for this agent.
MEMSTARA_EXPLANATION_PROVIDER=azure_foundry
# Model/deployment name; set explicitly for this agent.
MEMSTARA_EXPLANATION_MODEL=YOUR_MODEL_DEPLOYMENT
# Service URL; set explicitly for this agent.
MEMSTARA_EXPLANATION_API_BASE=https://YOUR_RESOURCE.services.ai.azure.com
# Response randomness; set explicitly for this agent.
MEMSTARA_EXPLANATION_TEMPERATURE=
# Requested output-token limit; set explicitly for this agent.
MEMSTARA_EXPLANATION_MAX_TOKENS=
# Reasoning effort; set explicitly for this agent.
MEMSTARA_EXPLANATION_EFFORT=

# Optional compute limits

# Maximum threads for OpenMP-based computations; 1 limits CPU use.
OMP_NUM_THREADS=1

# Maximum threads for OpenBLAS numerical operations; 1 limits CPU use.
OPENBLAS_NUM_THREADS=1

# Maximum threads for Intel MKL numerical operations; 1 limits CPU use.
MKL_NUM_THREADS=1

# Tokenizer parallel processing: true or false; false reduces concurrency.
TOKENIZERS_PARALLELISM=false

# Optional advanced inputs (normally leave unset)

# Optional ML documents folder: ml-reference.md and ml-results.md (hidden legacy report skill).
# MEMSTARA_SHARED_SKILLS_DIR=

# Writable folder for app-registered JSON skills; not arbitrary Markdown files. Prefer outputs/skills.
# MEMSTARA_USER_SKILLS_DIR=

# Legacy/unregistered execution only: JSON feature-exclusion rules.
# Registered research replaces these with its own target/exclusion rules; set those in the app.
# MEMSTARA_LEAKAGE_RULES_PATH=

# Optional addiction/hiv specialist source bindings; leave unset to use selected OKF.
# Requires a valid binding for each selected specialist; {} is not a working configuration.
# MEMSTARA_EXPLANATION_SOURCES_JSON='{}'

# Native development only (not used by ./start.sh)

# Native API server port. Full Docker startup uses private port 8000.
# MEMSTARA_API_PORT=8071

# Native control server port. Full Docker startup uses private port 8072.
# MEMSTARA_CONTROL_PORT=8072

# Legacy viewer/docker-compose.yml cache path; full Docker startup uses HF_HOME.
# MEMSTARA_EMBEDDING_CACHE=../outputs/embedding-cache
