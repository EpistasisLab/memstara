{
  // The top entry is the default. VS Code remembers the name of the configuration
  // last chosen, and falls back to the first one when that name is not here.
  //
  // ── Why the default is "full, 1 trial" ─────────────────────────────────
  //  --report-only runs stages (1)(2)(3)(6) only, which shows **one person** — the
  //  one who reports. Following what the hypothesis, data, training and
  //  interpretation roles did takes stages (4) and (5).
  //
  //  --run-tag is **deliberately left off.** Without it the name is generated from
  //  the clock on every run (board_20260820T094148), so every run starts from an
  //  empty board. Reusing one name mixes the previous run's notes in with this
  //  one's, and they become hard to tell apart.
  //
  //  One trial is also deliberate — five people appearing once each is the clearest
  //  way to watch the flow, whereas 3 trials only repeats the same scene three
  //  times. It also costs three times as much.
  // ─────────────────────────────────────────────────────────────────────
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "board pipeline · full, 1 trial (default)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "board pipeline · full, 3 trials",
      "args": [
        "--trials",
        "3",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "board pipeline · full, 1 trial · every litellm raw message (rarely used)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv",
        "MEMSTARA_LLM_RAW": "1"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "board pipeline · report only (fast, one LLM call)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "board pipeline · report only (stepping into motoro — spare)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "name": "1. tool harness (okf · data · ml · board)",
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.debug_harness",
      "args": [
        "${input:harnessMode}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "attach → okf (5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → data (5679)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5679
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → ml (5680)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5680
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → blackboard (5681)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5681
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "harnessMode",
      "type": "pickString",
      "description": "which tool to look at",
      "options": [
        "okf",
        "data",
        "ml",
        "board"
      ],
      "default": "data"
    }
  ]
}
