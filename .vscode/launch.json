{
  // 맨 위가 기본값이다. VS Code 는 마지막으로 고른 구성 이름을 기억하는데, 그
  // 이름이 여기 없으면 첫 번째로 되돌아간다.
  //
  // ── 기본을 "전체 1시행" 으로 둔 이유 ────────────────────────────────────
  //  ①②③⑥ 만 도는 --report-only 로는 **사람 한 명(보고 담당)** 밖에 안 보인다.
  //  가설·데이터·학습·해석 담당이 무엇을 했는지 따라가려면 ④⑤ 가 돌아야 한다.
  //
  //  --run-tag 를 **일부러 안 준다.** 안 주면 실행할 때마다 시각으로 이름이
  //  자동 생성되므로(board_20260820T094148), 매번 빈 게시판에서 시작한다.
  //  같은 이름을 재사용하면 지난 실행의 종이가 섞여 헷갈린다.
  //
  //  시행 1회로 둔 것도 의도다 — 다섯 명이 한 번씩 나오는 것이 흐름을 보기에
  //  가장 좋고, 3시행은 같은 장면이 세 번 반복될 뿐이다. 돈도 세 배 든다.
  // ─────────────────────────────────────────────────────────────────────
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "판 파이프라인 · 전체 1시행 (기본)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "판 파이프라인 · 전체 3시행",
      "args": [
        "--trials",
        "3",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "판 파이프라인 · 전체 1시행 · litellm 원문 전부 (거의 안 씀)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "HIV_DETECTABLE"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv",
        "MEMSTARA_LLM_RAW": "1"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "판 파이프라인 · 보고만 (빠름, LLM 1회)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "name": "판 파이프라인 · 보고만 (motoro 안까지 — 예비)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {
        "AGENTIC_OKF_BUNDLE_DIR": "${workspaceFolder}/../shared/hiv-suppression/okf",
        "MEMSTARA_DATASET_PATH": "${workspaceFolder}/outputs/hiv_cohort.csv"
      }
    },
    {
      "name": "도구 하네스 (okf · data · ml · board)",
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.debug_harness",
      "args": [
        "${input:harnessMode}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "attach → okf (5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → data (5679)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5679
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → ml (5680)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5680
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach → blackboard (5681)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5681
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "harnessMode",
      "type": "pickString",
      "description": "어느 도구를 볼까",
      "options": [
        "okf",
        "data",
        "ml",
        "board"
      ],
      "default": "data"
    }
  ]
}
