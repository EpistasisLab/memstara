{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "name": "board pipeline \u00b7 full, 1 trial (default)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "Y"
      ],
      "env": {}
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "name": "board pipeline \u00b7 full, 3 trials",
      "args": [
        "--trials",
        "3",
        "--y-column",
        "Y"
      ],
      "env": {}
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "name": "board pipeline \u00b7 full, 1 trial \u00b7 every litellm raw message (rarely used)",
      "args": [
        "--trials",
        "1",
        "--y-column",
        "Y"
      ],
      "env": {
        "MEMSTARA_LLM_RAW": "1"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "name": "board pipeline \u00b7 report only (fast, one LLM call)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {}
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.pipeline.board",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "name": "board pipeline \u00b7 report only (stepping into motoro \u2014 spare)",
      "args": [
        "--report-only",
        "--run-tag",
        "example"
      ],
      "env": {}
    },
    {
      "name": "1. tool harness (okf \u00b7 data \u00b7 ml \u00b7 board)",
      "type": "debugpy",
      "request": "launch",
      "module": "memstara.debug_harness",
      "args": [
        "${input:harnessMode}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "attach \u2192 okf (5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach \u2192 data (5679)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5679
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach \u2192 ml (5680)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5680
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "attach \u2192 blackboard (5681)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5681
      },
      "justMyCode": true,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "harnessMode",
      "type": "pickString",
      "description": "which tool to look at",
      "options": [
        "okf",
        "data",
        "ml",
        "board"
      ],
      "default": "data"
    }
  ]
}
