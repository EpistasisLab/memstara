{
  // ==========================================================================
  //  Select a Python 3.12 or 3.13 environment for this workspace.
  //  A local .venv may be a virtual environment or a link to a conda environment.
  //  Runtime dependency versions are pinned in pyproject.toml and uv.lock.
  // ==========================================================================

  // -- Read by the new Python Environments extension (ms-python.vscode-python-envs) --
  //
  // With that extension installed, the older `python.defaultInterpreterPath` is
  // often ignored, because environment selection is taken over by this one. So
  // **this workspace is pinned to the conda manager.**
  //
  // Developers can override the manager in their personal VS Code settings.
  "python-envs.defaultEnvManager": "ms-python.python:conda",

  // Where to look for environments inside the workspace. The default is
  // [".venv", "*/.venv"]. Keep personal conda installation paths out of Git.
  "python-envs.globalSearchPaths": [],

  // Do not use uv as the default tool. This environment was built with conda + pip,
  // and letting uv touch it makes it try to rebuild litellm from source, and fail.
  "python-envs.alwaysUseUv": false,

  // -- Read by the older Python extension (ms-python.python) -----------------
  //  A fallback for when the new extension is disabled, or the old UI is in use.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.condaPath": "conda",

  // So a new terminal opens in this environment. If `python` resolves to conda base
  // or the system 3.9, it reports that neither pandas nor asyncpg exists.
  "python.terminal.activateEnvironment": true,

  // -- Everything else --------------------------------------------------------
  //
  // VS Code's default is ${workspaceFolder}/.env, but this project has two .env
  // files (here + motoro). Reading only the one here leaves MOTORO_DATABASE_URL
  // empty and the run ends with "Environment is not ready". Launching through a
  // launch.json configuration is the safer route — the rest is filled in there.
  "python.envFile": "${workspaceFolder}/.env",

  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.testing.pytestEnabled": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "python-envs.defaultPackageManager": "ms-python.python:conda"
}
