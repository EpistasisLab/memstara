# Local files and generated artifacts. Rules are evaluated in order.
.env
.env.local
*.pem
*.key
outputs/*
!outputs/.gitkeep
!outputs/README.md
kg/
kg/**/*.db
kg/**/*.cypherl
.venv
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
CLAUDE.md
BACKLOG.md
*_KR*
scripts/backlog_to_issues.py
docs/
daily_log/
papers/
.DS_Store
~$*
*.[hH][eE][iI][cC]
/CHECKLIST.md
/spec/
/.venv.README
!/viewer/web/package-lock.json

# Local utilities and generated package artifacts.
/scripts/local/
/src/memstara/_version.py
/dist/

# Test and analysis artifacts.
.coverage
.coverage.*
coverage.xml
htmlcov/
.import_linter_cache/
/viewer/web/playwright-report/
/viewer/web/test-results/

/test-results/
/.venv-test/

# Local-only recorded examples for the developer lesson; never publish run artifacts.
/viewer/web/public/local-examples/

# Deployment-specific model endpoints; credentials remain in the runtime environment.
/config/stage-models.local.json
/config/*.local*.json

# Deployment-specific pricing and account mappings
config/pricing.local.json
config/azure-pricing-meters.local.json

# Local research inputs: official layout, not cleared for public distribution.
/resources/datasets/
/resources/knowledge/
/resources/manifests/*.local.json
